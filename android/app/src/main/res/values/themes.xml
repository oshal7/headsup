<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bujho" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bujho_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Bujho.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bujho_night</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Bujho</item>
    </style>
</resources>
